{
  "name": "daisy-launcher",
  "version": "1.0.0-beta.2",
  "daisyVersion": "1.0.0-beta.2",
  "description": "Daisy Minecraft Launcher",
  "author": "realvoidgojo",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "build:app": "node scripts/build-app.js",
    "start": "npm run build:app && electron .",
    "dist": "npm run build:app && electron-builder --win nsis portable",
    "dist:installer": "npm run build:app && electron-builder --win nsis",
    "dist:portable": "npm run build:app && electron-builder --win portable",
    "dist:dir": "npm run build:app && electron-builder --win dir",
    "dist:linux": "npm run build:app && electron-builder --linux dir && node scripts/package-linux.js",
    "release:draft": "node scripts/release-draft.js",
    "publish:update": "node scripts/publish-update.js",
    "publish:update:fast": "node scripts/publish-update.js --fast",
    "testers": "node scripts/testers.js",
    "blocklist": "node scripts/blocklist.js",
    "test": "node --test tests/*.test.js",
    "test:artifacts": "node --test tests/daisy-skin-artifacts.test.js",
    "test:startup": "node scripts/smoke-launcher.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.22",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.4.5",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "discord-rpc": "^4.0.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "semver": "^7.8.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.27.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.24.0"
  },
  "build": {
    "appId": "dev.daisy.launcher",
    "productName": "Daisy Launcher",
    "artifactName": "Daisy-${version}-${arch}.${ext}",
    "copyright": "Copyright 2026 realvoidgojo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "rvr",
        "name": "Daisy Instance",
        "description": "Daisy instance export",
        "icon": "packaging/icon.ico",
        "role": "Editor"
      }
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "packaging/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "app/bundled",
        "to": "bundled"
      }
    ],
    "win": {
      "icon": "packaging/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "executableName": "Daisy",
      "legalTrademarks": "Daisy",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "linux": {
      "icon": "packaging/icon.png",
      "category": "Game",
      "executableName": "daisy",
      "synopsis": "Minecraft launcher",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "packaging/icon.ico",
      "uninstallerIcon": "packaging/icon.ico",
      "artifactName": "Daisy-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daisy",
      "include": "packaging/installer.nsh"
    },
    "portable": {
      "artifactName": "Daisy-Portable.${ext}",
      "useZip": true
    },
    "asarUnpack": [
      "**/np-helper.exe",
      "**/now-playing.ps1"
    ]
  },
  "license": "MIT",
  "overrides": {
    "minimatch": "11.0.8"
  }
}
