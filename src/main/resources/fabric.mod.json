{
  "schemaVersion": 1,
  "id": "clientcore",
  "version": "${version}",
  "name": "Daisy Client",
  "icon": "assets/clientcore/icon.png",
  "description": "A Fabric ${minecraft_version} PvP-friendly client by realvoidgojo.",
  "authors": [
    "WyZ_EU (original client)",
    "realvoidgojo (Daisy branding)"
  ],
  "contact": {
    "sources": "https://github.com/realvoidgojo/Daisy-Client"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.daisy.clientcore.ClientCore"
      }
    ]
  },
  "mixins": [
    "clientcore.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}
